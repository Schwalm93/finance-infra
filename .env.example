# Registry images produced by app-backend and app-frontend Forgejo pipelines
BACKEND_IMAGE=registry.example.lan/finance/backend:main-abcdef0
FRONTEND_IMAGE=registry.example.lan/finance/frontend:main-abcdef0

# Database settings
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=mydb

# Exposed ports on the homelab host
HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8080
PGWEB_PORT=8081

# For homelab only; disable for internet-facing setups
TRAEFIK_DASHBOARD_INSECURE=true
